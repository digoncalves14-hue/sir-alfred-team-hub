# Worker de processamento audiovisual (FFmpeg) — roda separado da aplicação web.
FROM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core fonts-open-sans fonts-noto-core fontconfig ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/worker ./apps/worker
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci --workspace @vision/worker --include-workspace-root --no-audit --no-fund
ENV NODE_ENV=production WORKER_TMP_DIR=/tmp/vision LOCAL_STORAGE_DIR=/data/storage
USER node
CMD ["node_modules/.bin/tsx", "apps/worker/src/index.ts"]
