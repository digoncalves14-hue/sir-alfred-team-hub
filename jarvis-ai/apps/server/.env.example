# Copie para apps/server/.env e preencha. NUNCA faça commit do .env.

# Supabase (Project Settings → API). Use a chave PÚBLICA (publishable/anon).
# O backend não precisa da service_role: ele age com o token do usuário e o RLS vale.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-a-chave-publishable-ou-anon

# Claude (https://platform.claude.com → API Keys). Fica SOMENTE no backend.
ANTHROPIC_API_KEY=
# Modelo e esforço. claude-opus-5-5 é o padrão; claude-sonnet-5-5 e claude-haiku-5-5 custam menos.
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_FALLBACKS=true

# Voz premium opcional (ElevenLabs). Sem isso, o app usa a voz nativa do iPhone (gratuita).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Estimativa de custo por 1.000 caracteres no seu plano ElevenLabs (para o painel de consumo).
TTS_COST_PER_1K_CHARS_USD=0.10

# ---------------- Fase 2: Google, notificações e agendador ----------------
# Supabase → Project Settings → API → service_role (SECRETA; só no backend, nunca no app).
# Necessária para gravar tokens do Google, enviar push e rodar o agendador.
SUPABASE_SERVICE_ROLE_KEY=
# Chave que cifra os tokens do Google (32 bytes). Gere com:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Google Cloud Console → Credenciais → ID do cliente OAuth do tipo **iOS** (sem client secret).
GOOGLE_IOS_CLIENT_ID=
# Agendador de lembretes / resumo diário / lembretes de reunião (precisa do servidor sempre ligado).
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# Opcional: protege POST /internal/cron/tick para um cron externo (mín. 16 caracteres).
CRON_SECRET=
# Opcional: só se você ativar "Enhanced push security" no projeto Expo.
EXPO_ACCESS_TOKEN=

PORT=8787
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=60
