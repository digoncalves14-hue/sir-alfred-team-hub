# ===== VISION AI STUDIO — variáveis de ambiente =====
# Copie para .env e ajuste. Nunca exponha estas chaves no navegador.

# Banco de dados PostgreSQL
DATABASE_URL=postgres://vision:vision@localhost:5432/vision

# URL pública da aplicação e segredo para assinar cookies/URLs (mín. 32 caracteres em produção)
APP_URL=http://localhost:3000
APP_SECRET=troque-por-um-segredo-longo-e-aleatorio-de-32+caracteres

# Armazenamento: "local" (disco) ou "s3" (AWS S3, Cloudflare R2, MinIO…)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=vision
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Limites de upload
MAX_UPLOAD_MB=4096
MULTIPART_PART_MB=16

# Processamento (worker)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORKER_CONCURRENCY=2
WORKER_TMP_DIR=./data/tmp
# FONTS_DIR=/usr/share/fonts/vision
MAX_SOURCE_DURATION_MIN=240

# IA de edição (planejamento de cortes e análise visual por quadros)
# Sem chave, um interpretador local de comandos em português é usado.
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_VISION_FRAMES=10

# Transcrição: "openai" (API de áudio) ou "whisper_cpp" (local)
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# WHISPER_CPP_BIN=/usr/local/bin/whisper-cli
# WHISPER_CPP_MODEL=/models/ggml-medium.bin

# Controle de custos (por organização; podem ser sobrescritos no banco)
MONTHLY_AI_BUDGET_USD=20
STORAGE_LIMIT_GB=50
MONTHLY_RENDER_MINUTES=600
ALLOW_SIGNUP=true
