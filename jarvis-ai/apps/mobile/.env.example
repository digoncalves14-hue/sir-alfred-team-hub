# Copie para apps/mobile/.env. Variáveis EXPO_PUBLIC_* ficam embutidas no app:
# coloque aqui APENAS valores públicos (nunca a chave da IA).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-publishable-ou-anon
# Endereço do backend. Em desenvolvimento: IP do computador na mesma rede Wi-Fi do iPhone.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8787
# Fase 2 — ID do cliente OAuth iOS do Google (o MESMO de GOOGLE_IOS_CLIENT_ID no backend).
# É público; serve para registrar o retorno do login Google no app.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
