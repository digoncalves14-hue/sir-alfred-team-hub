# Backend do JARVIS AI + versão web do app (um único serviço).
# Build a partir da pasta jarvis-ai/:
#   docker build -f Dockerfile.server -t jarvis-server .

# ---- 1) Exporta o app para a web (Expo) ----
FROM node:22-bookworm-slim AS web
WORKDIR /src
ENV EXPO_NO_TELEMETRY=1 CI=1
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/
COPY apps/mobile/package.json apps/mobile/
RUN npm ci --ignore-scripts
COPY packages/shared packages/shared
COPY apps/mobile apps/mobile
# A configuração do Supabase NÃO entra no bundle: o servidor a injeta no index.html.
RUN cd apps/mobile && npx expo export --platform web --output-dir /web

# ---- 2) Servidor ----
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production WEB_DIR=/app/web
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/
COPY apps/mobile/package.json apps/mobile/
RUN npm ci --workspace=@jarvis/server --include-workspace-root=false --omit=dev --ignore-scripts
COPY packages/shared packages/shared
COPY apps/server/src apps/server/src
COPY apps/server/tsconfig.json apps/server/
COPY --from=web /web /app/web
USER node
EXPOSE 8787
CMD ["node", "--import", "tsx", "apps/server/src/index.ts"]
