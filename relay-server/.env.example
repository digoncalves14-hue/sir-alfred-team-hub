PORT=8787

# Gere um valor aleatório forte (ex: openssl rand -hex 32) e use o mesmo
# valor no secret APPBARBER_RELAY_SECRET da Edge Function no Supabase.
RELAY_SECRET=

# Preencher com o que vier da documentação do AppBarber.
APPBARBER_BASE_URL=
APPBARBER_API_KEY=
# Só mude se a doc do AppBarber pedir outro header/esquema de autenticação.
APPBARBER_AUTH_HEADER=Authorization
APPBARBER_AUTH_SCHEME=Bearer
